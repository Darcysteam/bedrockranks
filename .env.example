# Fake examples. Real values: Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# Telegram (optional; site works without them). Links are public, bot values are SECRET (server only, no NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_TELEGRAM_NEWS_URL=https://t.me/your_news_channel
NEXT_PUBLIC_TELEGRAM_CHAT_URL=https://t.me/your_chat
TELEGRAM_BOT_TOKEN=123456:fake-token
TELEGRAM_CHANNEL_ID=@your_news_channel
